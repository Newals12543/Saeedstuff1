            { id: 95, q: "کدام عبارت غلط است؟", o: ["هیستوپلاسما کپسولاتوم دارای کپسول قندی است.", "پیتریازیس ورسیکالر مسری نیست.", "دیر حمام رفتن عامل ابتلا به تینه آورسیکالر است.", "پیوند عضو موجب ابتلا به کاندیدیازیس میشود."], c: 0 },
            { id: 96, q: "کدامیک از فرم های کاندیدیازیس زیر مرتبط با کمبود ویتامین B2 است؟", o: ["ترک گوشه لبها", "کاندیدیازیس نواحی چین دار بدن", "بثورات قنداقی", "کاندیدیازیس مخاطی جلدی مزمن (CMC)"], c: 0 },
            { id: 97, q: "درباره کاندیدیازیس کدامیک از عبارات زیر غلط است؟", o: ["دیابت جزء زمینه های مهم ابتلاء به فرم احشایی است", "تربینافین و پنی سیلین داروی انتخابی اشکال مخاطی بیماری است", "در مبتلایان به ایدز فرم جلدی مخاطی بیماری شایعتر است", "بثورات قنداقی یک فرم بسیار شایع جلدی است"], c: 1 },
            { id: 98, q: "کدامیک از عبارات زیر غلط است؟", o: ["کاندیدا آلبیکنس شایع ترین عامل کاندیدیازیس انسان است", "موکور مایکوزیس رینو سربرال روندی بسیار مزمن دارد", "آمفوتریسین ب درمان انتخابی کریپتوکوکوزیس است", "فرم جلدی لنفاوی شایعترین فرم اسپورتریکوزیس است"], c: 1 },
            { id: 99, q: "قرمزی و لکه سفید پنیری بر روی زبان یک نوزاد ممکن است کدام بیماری باشد؟", o: ["پیتریازیس ورسیکالر", "درماتوفیتوزیس", "کاندیدیازیس", "مای ستوما"], c: 2 },
            { id: 100, q: "این بیماری ایجاد توده زیر جلدی می نماید.", o: ["اسپوروتریکوزیس", "کاندیدیازیس", "پیتریازیس ورسیکالر", "مایستوما"], c: 3 },
