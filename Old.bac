<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>بانک سوالات و درسنامه جامع قارچ‌شناسی پزشکی</title>
    <style>
        :root {
            --bg-gradient: linear-gradient(135deg, #090d16 0%, #15162c 50%, #1e1b4b 100%);
            --glass-bg: rgba(255, 255, 255, 0.03);
            --glass-border: rgba(255, 255, 255, 0.08);
            --glass-hover: rgba(255, 255, 255, 0.07);
            --card-bg: rgba(255, 255, 255, 0.04);
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --accent-primary: #6366f1;
            --accent-hover: #4f46e5;
            --success: #10b981;
            --error: #ef4444;
            --warning: #f59e0b;
            --wave-color-1: rgba(255, 75, 114, 0.8);
            --wave-color-2: rgba(255, 75, 114, 0.5);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        }

        body {
            background: var(--bg-gradient);
            color: var(--text-primary);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 10px;
            transition: background 0.5s ease, color 0.5s ease;
            overflow-x: hidden;
        }

        .container {
            width: 100%;
            max-width: 780px;
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            padding: 20px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.4);
            transition: all 0.5s ease;
            position: relative;
        }

        .screen {
            display: none;
        }

        .screen.active {
            display: block;
            animation: fadeInScreen 0.3s ease forwards;
        }

        @keyframes fadeInScreen {
            from { opacity: 0; transform: translateY(4px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* هدر بالا (تاگل تم، مود و دکمه خروج/ریست) - بسیار فشرده */
        .top-controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--glass-border);
        }

        .top-left-group {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .mode-toggle-switch {
            display: flex;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid var(--glass-border);
            border-radius: 30px;
            padding: 2px;
        }

        .mode-option {
            padding: 5px 12px;
            font-size: 0.75rem;
            font-weight: 600;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.3s ease;
            color: var(--text-secondary);
            border: none;
            background: transparent;
        }

        .mode-option.active {
            background: var(--accent-primary);
            color: #ffffff;
            box-shadow: 0 2px 8px rgba(99, 102, 241, 0.4);
        }

        .icon-btn {
            padding: 0;
            border-radius: 50%;
            width: 36px;
            height: 36px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1rem;
            cursor: pointer;
            background: rgba(255,255,255,0.06);
            border: 1px solid var(--glass-border);
            color: var(--text-primary);
            transition: all 0.2s;
        }

        .icon-btn:hover {
            background: var(--glass-hover);
        }

        /* هیرو کارت کاملاً فشرده (بدون نیاز به اسکرول) */
        .hero-card {
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 12px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        }

        .hero-info h2 {
            font-size: 1.1rem;
            color: var(--accent-primary);
            margin-bottom: 2px;
        }

        .hero-info p {
            font-size: 0.78rem;
            color: var(--text-secondary);
        }

        /* ارلن تسلط مینیاتوری */
        .mastery-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .mastery-container:hover {
            transform: scale(1.05);
        }

        .flask-wrapper {
            position: relative;
            width: 40px;
            height: 52px;
            margin-bottom: 4px;
        }

        .flask-shape {
            width: 100%;
            height: 100%;
            background: rgba(255, 255, 255, 0.01);
            clip-path: polygon(32% 0%, 68% 0%, 68% 8%, 64% 8%, 64% 35%, 100% 90%, 100% 100%, 0% 100%, 0% 90%, 36% 35%, 36% 8%, 32% 8%);
            position: relative;
            overflow: hidden;
            border: 2px solid rgba(255, 255, 255, 0.2);
        }

        .liquid {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 0%;
            transition: height 1.2s cubic-bezier(0.4, 0, 0.2, 1), background 0.8s ease;
        }

        .wave {
            position: absolute;
            top: -10px;
            left: 50%;
            width: 100px;
            height: 100px;
            background: var(--wave-color-1);
            border-radius: 40%;
            transform: translateX(-50%);
            animation: rotateWave 3.5s linear infinite;
            pointer-events: none;
            z-index: 2;
        }

        .wave:nth-child(2) {
            top: -12px;
            background: var(--wave-color-2);
            border-radius: 38%;
            animation: rotateWave 5.5s linear infinite;
            z-index: 1;
        }

        .liquid.color-low { background: #be123c; }
        .liquid.color-mid { background: #d97706; }
        .liquid.color-high { background: #1d4ed8; }
        .liquid.color-max { background: #047857; }

        @keyframes rotateWave {
            0% { transform: translateX(-50%) rotate(0deg); }
            100% { transform: translateX(-50%) rotate(360deg); }
        }

        .mastery-label {
            font-size: 0.7rem;
            color: var(--text-primary);
            font-weight: 600;
            background: rgba(255, 255, 255, 0.06);
            padding: 1px 6px;
            border-radius: 10px;
            border: 1px solid var(--glass-border);
        }

        /* بخش‌بندی محتوا در داشبورد فشرده */
        .section-title {
            font-size: 0.82rem;
            color: var(--text-secondary);
            margin-bottom: 8px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .section-title::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--glass-border);
        }

        .grid-menu {
            display: grid;
            grid-template-columns: 1fr;
            gap: 8px;
            margin-bottom: 12px;
        }

        @media (min-width: 540px) {
            .grid-menu {
                grid-template-columns: repeat(2, 1fr);
            }
            .full-width {
                grid-column: span 2;
            }
        }

        /* دکمه‌های بسیار فشرده برای جلوگیری از اسکرول */
        .btn {
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            color: var(--text-primary);
            padding: 10px 14px;
            border-radius: 12px;
            cursor: pointer;
            font-size: 0.82rem;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: space-between;
            text-align: right;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        }

        .btn:hover {
            background: var(--glass-hover);
            border-color: var(--accent-primary);
            transform: translateY(-1px);
        }

        .btn-content {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .btn-accent {
            background: var(--accent-primary);
            border: none;
            color: #ffffff;
        }

        .btn-accent:hover {
            background: var(--accent-hover);
        }

        .btn-nav {
            padding: 8px 14px;
            font-size: 0.8rem;
            justify-content: center;
            flex-direction: row;
        }

        .badge {
            font-size: 0.65rem;
            background: rgba(255,255,255,0.08);
            padding: 2px 6px;
            border-radius: 16px;
            color: var(--text-secondary);
            font-weight: 500;
        }

        .badge-accent {
            background: rgba(255, 255, 255, 0.2);
            color: #ffffff;
        }

        /* درسنامه خلاصه */
        .summary-box {
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 15px;
            line-height: 1.8;
            font-size: 0.9rem;
            max-height: 60vh;
            overflow-y: auto;
            text-align: justify;
        }

        .summary-box h3 {
            color: var(--accent-primary);
            margin: 14px 0 6px 0;
            font-size: 1.05rem;
        }

        .summary-box ul {
            padding-right: 18px;
            margin-bottom: 10px;
        }

        .summary-box li {
            margin-bottom: 5px;
        }

        /* حفظ سوالات */
        .memorize-container {
            max-height: 65vh;
            overflow-y: auto;
            padding-left: 5px;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .memo-card {
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            border-radius: 14px;
            padding: 16px;
        }

        .memo-q {
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 10px;
            line-height: 1.5;
            white-space: pre-line;
        }

        .memo-opts {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .memo-opt {
            padding: 8px 12px;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--glass-border);
            font-size: 0.85rem;
        }

        .memo-opt.correct-ans {
            background: rgba(16, 185, 129, 0.15);
            border-color: var(--success);
            color: #a7f3d0;
            font-weight: 600;
        }

        /* آزمون */
        .quiz-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            border-bottom: 1px solid var(--glass-border);
            padding-bottom: 10px;
        }

        .quiz-title {
            font-size: 0.9rem;
            color: var(--text-secondary);
        }

        .question-text {
            font-size: 1rem;
            line-height: 1.6;
            margin-bottom: 15px;
            font-weight: 500;
            white-space: pre-line;
        }

        .options-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .option-item {
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            padding: 12px 16px;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.2s ease;
            font-size: 0.88rem;
            line-height: 1.4;
        }

        .option-item:hover {
            background: var(--glass-hover);
            border-color: rgba(255, 255, 255, 0.2);
        }

        .option-item.correct {
            background: rgba(16, 185, 129, 0.2) !important;
            border-color: var(--success) !important;
            color: #a7f3d0;
        }

        .option-item.wrong {
            background: rgba(239, 68, 68, 0.2) !important;
            border-color: var(--error) !important;
            color: #fca5a5;
        }

        .option-item.disabled {
            pointer-events: none;
        }

        .quiz-footer {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
            gap: 10px;
        }

        /* مدال‌های سفارشی */
        .custom-modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(9, 13, 22, 0.8);
            backdrop-filter: blur(8px);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            animation: fadeIn 0.2s forwards;
        }

        .custom-modal {
            background: #15162c;
            border: 1px solid var(--glass-border);
            border-radius: 18px;
            padding: 20px;
            width: 90%;
            max-width: 360px;
            text-align: center;
            box-shadow: 0 25px 50px rgba(0,0,0,0.5);
            animation: scaleUp 0.2s forwards;
        }

        .custom-modal p {
            font-size: 0.9rem;
            color: var(--text-secondary);
            margin-bottom: 15px;
            line-height: 1.5;
        }

        .custom-modal input {
            width: 100%;
            padding: 10px;
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--glass-border);
            border-radius: 10px;
            color: var(--text-primary);
            font-size: 0.95rem;
            text-align: center;
            margin-bottom: 15px;
            outline: none;
        }

        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes scaleUp { from { transform: scale(0.9); } to { transform: scale(1); } }

        /* لایت مود */
        body.light-mode {
            --bg-gradient: linear-gradient(135deg, #f1f5f9 0%, #cbd5e1 100%);
            --glass-bg: rgba(255, 255, 255, 0.85);
            --glass-border: rgba(0, 0, 0, 0.1);
            --glass-hover: rgba(255, 255, 255, 0.98);
            --card-bg: rgba(255, 255, 255, 0.75);
            --text-primary: #0f172a;
            --text-secondary: #475569;
            --accent-primary: #4f46e5;
            --accent-hover: #4338ca;
        }

        body.light-mode .custom-modal {
            background: #ffffff;
            color: #0f172a;
        }

        body.light-mode .badge {
            background: rgba(0, 0, 0, 0.06);
            color: var(--text-secondary);
        }

        body.light-mode .badge-accent {
            background: rgba(79, 70, 229, 0.15);
            color: var(--accent-primary);
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- هدر بالا شامل تاگل تم، مود و دکمه خروج -->
        <div class="top-controls">
            <div class="top-left-group">
                <button id="theme-toggle" class="icon-btn" title="تغییر تم">☀️</button>
                <button id="logout-btn" class="icon-btn" title="خروج و پاک کردن اطلاعات" onclick="logout()">🚪</button>
            </div>
            <div class="mode-toggle-switch">
                <button class="mode-option" id="mode-classic" onclick="setMode('classic')">کلاسیک</button>
                <button class="mode-option active" id="mode-modern" onclick="setMode('modern')">مدرن</button>
            </div>
        </div>

        <div id="modal-container"></div>

        <!-- داشبورد اصلی -->
        <div id="dashboard-screen" class="screen active">
            <!-- هیرو کارت: خوش‌آمدگویی و ارلن تسلط مینیاتوری -->
            <div class="hero-card">
                <div class="hero-info">
                    <h2 id="greeting">سلام!</h2>
                    <p id="dashboard-subtitle">سیستم هوشمند مرور و آزمون قارچ‌شناسی</p>
                </div>
                <div class="mastery-container" onclick="showMasteryDetails()" title="مشاهده درصد تسلط">
                    <div class="flask-wrapper">
                        <div class="flask-shape">
                            <div class="liquid" id="flask-liquid">
                                <div class="wave"></div>
                                <div class="wave"></div>
                            </div>
                        </div>
                    </div>
                    <div class="mastery-label" id="mastery-percentage">0%</div>
                </div>
            </div>

            <!-- بخش محتوای اصلی بر اساس حالت -->
            <div id="main-content-area"></div>

            <!-- بخش ابزارهای مرور هوشمند (فشرده و بدون نیاز به اسکرول) -->
            <div class="section-title">مرور و آزمون هوشمند</div>
            <div class="grid-menu" style="grid-template-columns: repeat(3, 1fr) !important; gap: 6px; margin-bottom: 0;">
                <button class="btn" style="flex-direction: column; align-items: center; text-align: center; padding: 8px 6px; border-color: rgba(239, 68, 68, 0.3); color: #ef4444;" onclick="startChallengeQuiz()">
                    <span style="font-weight: 600; font-size: 0.78rem;">🎯 چالش</span>
                    <span class="badge" id="challenge-count" style="background: rgba(239, 68, 68, 0.1); color: #ef4444; margin-top: 2px;">۰ سوال</span>
                </button>
                <button class="btn" style="flex-direction: column; align-items: center; text-align: center; padding: 8px 6px; border-color: rgba(234, 179, 8, 0.3); color: #f59e0b;" onclick="startBookmarkQuiz()">
                    <span style="font-weight: 600; font-size: 0.78rem;">⭐ نشان‌دار</span>
                    <span class="badge" id="bookmark-count" style="background: rgba(234, 179, 8, 0.1); color: #f59e0b; margin-top: 2px;">۰ سوال</span>
                </button>
                <button class="btn btn-accent" style="flex-direction: column; align-items: center; text-align: center; padding: 8px 6px;" onclick="startRandomComprehensiveQuiz()">
                    <span style="font-weight: 600; font-size: 0.78rem;">🎲 جامع رندوم</span>
                    <span class="badge badge-accent" style="margin-top: 2px;">۱۵۳ سوال</span>
                </button>
            </div>
        </div>

        <!-- صفحه زیرمبحث‌های جلسه (مدرن) -->
        <div id="subtopics-screen" class="screen">
            <div class="quiz-header">
                <span class="quiz-title" id="session-main-title">جلسه</span>
                <button class="btn btn-nav btn-accent" onclick="goHome()">بازگشت به خانه</button>
            </div>
            <div class="section-title">انتخاب زیرمبحث</div>
            <div class="grid-menu" id="subtopics-grid"></div>
        </div>

        <!-- صفحه درسنامه‌ها به تفکیک جلسه و زیرمبحث (کلاسیک) -->
        <div id="classic-notes-sessions-screen" class="screen">
            <div class="quiz-header">
                <span class="quiz-title">درسنامه‌ها به تفکیک جلسات</span>
                <button class="btn btn-nav btn-accent" onclick="goHome()">بازگشت به خانه</button>
            </div>
            <div class="grid-menu" id="classic-notes-sessions-grid"></div>
        </div>

        <div id="classic-notes-subtopics-screen" class="screen">
            <div class="quiz-header">
                <span class="quiz-title" id="classic-sess-title">جلسه</span>
                <button class="btn btn-nav btn-accent" onclick="openClassicNotesSessions()">بازگشت</button>
            </div>
            <div class="grid-menu" id="classic-notes-subtopics-grid"></div>
        </div>

        <!-- صفحه انتخاب گزینه (درسنامه یا سوالات) برای جلسات (مدرن) -->
        <div id="options-screen" class="screen">
            <div class="quiz-header">
                <span class="quiz-title" id="subtopic-header-title">زیرمبحث</span>
                <button class="btn btn-nav btn-accent" onclick="backToSubtopics()">بازگشت</button>
            </div>
            <div class="grid-menu">
                <button class="btn btn-accent" style="padding: 18px;" onclick="openSummary()">
                    <div class="btn-content">
                        <span style="font-size: 1rem; font-weight: bold;">📖 درسنامه خلاصه</span>
                        <span style="font-size: 0.78rem; opacity: 0.8;">مطالعه نکات کلیدی و مفهومی</span>
                    </div>
                </button>
                <button class="btn" style="padding: 18px;" id="btn-goto-questions" onclick="openQuestionsMenu()">
                    <div class="btn-content">
                        <span style="font-size: 1rem; font-weight: bold;">❓ بانک سوالات تستی</span>
                        <span style="font-size: 0.78rem; color: var(--text-secondary);" id="subtopic-q-count">سوالات تستی</span>
                    </div>
                </button>
            </div>
        </div>

        <!-- صفحه انتخاب گزینه برای حالت ۵ بخشی (کلاسیک) -->
        <div id="section-options-screen" class="screen">
            <div class="quiz-header">
                <span class="quiz-title" id="section-option-title">بخش</span>
                <button class="btn btn-nav btn-accent" onclick="goHome()">بازگشت</button>
            </div>
            <div class="grid-menu">
                <button class="btn btn-accent" style="padding: 18px;" onclick="startSectionMemorize()">
                    <div class="btn-content">
                        <span style="font-size: 1rem; font-weight: bold;">🧠 حفظ سوالات</span>
                        <span style="font-size: 0.78rem; opacity: 0.8;">مشاهده تمام سوالات با پاسخ صحیح (اسکرول)</span>
                    </div>
                </button>
                <button class="btn" style="padding: 18px;" onclick="startSectionQuiz()">
                    <div class="btn-content">
                        <span style="font-size: 1rem; font-weight: bold;">⏱️ تمرین (رندوم سوال و گزینه)</span>
                        <span style="font-size: 0.78rem; color: var(--text-secondary);">آزمون و تمرین تعاملی</span>
                    </div>
                </button>
            </div>
        </div>

        <!-- صفحه انتخاب حالت سوالات (حفظ یا تمرین) برای جلسات -->
        <div id="questions-mode-screen" class="screen">
            <div class="quiz-header">
                <span class="quiz-title" id="qmode-header-title">حالت سوالات</span>
                <button class="btn btn-nav btn-accent" onclick="backToOptions()">بازگشت</button>
            </div>
            <div class="grid-menu">
                <button class="btn btn-accent" style="padding: 18px;" onclick="startMemorizeMode()">
                    <div class="btn-content">
                        <span style="font-size: 1rem; font-weight: bold;">🧠 حفظ سوالات</span>
                        <span style="font-size: 0.78rem; opacity: 0.8;">مشاهده تمام سوالات با پاسخ صحیح (اسکرول)</span>
                    </div>
                </button>
                <button class="btn" style="padding: 18px;" onclick="startQuizMode()">
                    <div class="btn-content">
                        <span style="font-size: 1rem; font-weight: bold;">⏱️ تمرین (رندوم سوال و گزینه)</span>
