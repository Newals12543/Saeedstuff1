            { id: 37, q: "فلورسانس زرد طلایی تحت وود لامپ در .....", o: ["پیتریازیس ورسیکالر دیده میشوند", "اریتراسما دیده میشوند", "فاووس دیده میشوند", "هیچکدام"], c: 0 },
            { id: 38, q: "عامل شایع تر کچلی ناخن است.", o: ["ترایکوفایتون وروکوزوم", "میکروسپوروم کانیس", "میکروسپوروم جیپسئوم", "ترایکوفایتون روبروم"], c: 3 },
            { id: 39, q: "این دارو درمان درماتوفیتوزیس (کچلی) است؟", o: ["تربینافین", "پنی سیلین", "استرپتومایسین", "همه موارد"], c: 0 },
