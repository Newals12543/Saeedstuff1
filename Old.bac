            { id: 147, q: "درمان اختصاصی کریپتوکوکوزیس است.", o: ["گریزئوفولوین", "پنی سیلین", "فلوسیتوزین", "استرپتومایسین"], c: 2 },
            { id: 148, q: "درمان انتخابی کریپتوکوکوزیس؟", o: ["Terbinafine", "Clotrimazole", "Amphotericin-B + Flucytosine", "Terbinafine + Griseofulvin"], c: 2 },
            { id: 149, q: "در مورد کریپتوکوکوزیس کدامیک از عبارات زیر غلط است؟", o: ["قارچ از فضله کبوتر جدا میشود", "مننژیت شایع ترین فرم بیماری است", "فرم جلدی آن نادر است", "کپسول قارچ با استفاده رنگ آمیزی گرم قابل مشاهده است"], c: 3 },
            { id: 150, q: "در مورد کریپتوکوکوزیس کدام غلط است؟", o: ["کیست استخوانی از اشکال این بیماری است.", "بیماری مسری است.", "ایجاد مننژیت مزمن میکند.", "با کشت قارچ شناسی قابل شناسایی است."], c: 1 },
            { id: 151, q: "این دارو با مهار سنتز ارگوسترول باعث ممانعت از رشد قارچ میشود:", o: ["نیستاتین", "آمفوتریسین ب", "فلوسیتوزین", "تربینافین"], c: 3 },
            { id: 152, q: "مکانیسم عمل ضد قارچی تربینافین ......... است.", o: ["مهار سنتز گلوکاگون دیواره سلولی", "مهار سنتز ارگسترول", "مهار سنتز DNA", "مهار تشکیل دوک تقسیم"], c: 1 },
            { id: 153, q: "مکانیسم عمل ضد قارچی آزولها (فلوکونازول) شامل ......... است .", o: ["مهارتشکیل دوک تقسیم", "مهار سنتز گلوکان دیواره سلولی", "مهار سنتز DNA", "مهار سنتز ارگوسترول"], c: 3 }
        ];

        // --- متغیرهای حالت برنامه ---
        let viewMode = localStorage.getItem('mycology_view_mode') || 'modern'; // 'classic' or 'modern'
        let currentSession = null;
        let currentSubtopic = null;
        let currentSectionNum = null;
        let currentQuestionsList = [];
        let currentIndex = 0;
        let userAnswers = {};
        let isChallengeMode = false;
        let isBookmarkMode = false;

        let stats = JSON.parse(localStorage.getItem('mycology_stats')) || {};
        let bookmarks = JSON.parse(localStorage.getItem('mycology_bookmarks')) || {};

        // سیستم مدال سفارشی
        const CustomUI = {
            alert: function(text, callback) {
                const container = document.getElementById('modal-container');
                container.innerHTML = `
                    <div class="custom-modal-overlay">
                        <div class="custom-modal">
                            <p>${text}</p>
                            <div style="margin-top: 15px;">
                                <button class="btn btn-accent" id="modal-ok" style="width: 100%; justify-content: center;">تایید</button>
                            </div>
                        </div>
                    </div>
                `;
                document.getElementById('modal-ok').onclick = function() {
                    container.innerHTML = '';
                    if(callback) callback();
                };
            },
            confirm: function(text, onConfirm) {
                const container = document.getElementById('modal-container');
                container.innerHTML = `
                    <div class="custom-modal-overlay">
                        <div class="custom-modal">
                            <p>${text}</p>
                            <div style="display: flex; gap: 10px; margin-top: 15px;">
                                <button class="btn btn-accent" id="modal-yes" style="flex:1; justify-content: center;">بله</button>
                                <button class="btn" id="modal-no" style="flex:1; justify-content: center;">لغو</button>
                            </div>
                        </div>
                    </div>
                `;
                document.getElementById('modal-yes').onclick = function() {
                    container.innerHTML = '';
                    onConfirm();
                };
                document.getElementById('modal-no').onclick = function() {
                    container.innerHTML = '';
                };
            },
            prompt: function(text, onSubmit) {
                const container = document.getElementById('modal-container');
                container.innerHTML = `
                    <div class="custom-modal-overlay">
                        <div class="custom-modal">
                            <p>${text}</p>
                            <input type="text" id="modal-input" placeholder="نام شما..." autofocus />
                            <button class="btn btn-accent" id="modal-submit" style="width: 100%; justify-content: center;">ثبت نام</button>
                        </div>
                    </div>
                `;
                const submitAction = function() {
                    const val = document.getElementById('modal-input').value;
                    container.innerHTML = '';
                    onSubmit(val);
                };
                document.getElementById('modal-submit').onclick = submitAction;
                document.getElementById('modal-input').onkeydown = function(e) {
                    if (e.key === 'Enter') submitAction();
                };
            }
        };

        function logout() {
            CustomUI.confirm('آیا مطمئن هستید که می‌خواهید خارج شوید؟ تمام اطلاعات و آمارهای شما پاک خواهد شد.', function() {
                localStorage.clear();
                location.reload();
            });
        }

        function checkUser() {
            let username = localStorage.getItem('mycology_username');
            if (!username) {
                CustomUI.prompt('خوش آمدید! لطفا نام خود را وارد کنید:', function(inputName) {
                    username = (inputName && inputName.trim() !== "") ? inputName.trim() : 'دانشجوی پزشکی';
                    localStorage.setItem('mycology_username', username);
                    document.getElementById('greeting').innerText = `سلام ${username}!`;
                    initApp();
                });
            } else {
                document.getElementById('greeting').innerText = `سلام ${username}!`;
                initApp();
            }
        }

        function initApp() {
            updateToggleUI();
            renderDashboard();
        }

        function setMode(mode) {
            viewMode = mode;
            localStorage.setItem('mycology_view_mode', mode);
            updateToggleUI();
            renderDashboard();
        }

        function updateToggleUI() {
            document.getElementById('mode-classic').classList.toggle('active', viewMode === 'classic');
            document.getElementById('mode-modern').classList.toggle('active', viewMode === 'modern');
        }

        // رندر کردن داشبورد اصلی به صورت کاملاً فشرده (بدون نیاز به اسکرول)
        function renderDashboard() {
            const containerArea = document.getElementById('main-content-area');
            containerArea.innerHTML = '';
            const subtitleEl = document.getElementById('dashboard-subtitle');

            if (viewMode === 'modern') {
                subtitleEl.innerText = 'سیستم آموزشی مدرن (۷ جلسه و زیرمبحث‌ها)';
                
                const titleEl = document.createElement('div');
                titleEl.className = 'section-title';
                titleEl.innerText = 'سرفصل جلسات آموزشی';
                containerArea.appendChild(titleEl);

                const grid = document.createElement('div');
                grid.className = 'grid-menu';
                grid.style.maxHeight = '240px';
                grid.style.overflowY = 'auto';
                grid.style.paddingLeft = '4px';

                mycologyData.sessions.forEach(sess => {
                    const btn = document.createElement('button');
                    btn.className = 'btn';
                    btn.style.padding = '8px 12px';
                    btn.innerHTML = `
                        <div class="btn-content">
                            <span style="font-weight: 600; font-size: 0.82rem;">${sess.title}</span>
                            <span style="font-size: 0.72rem; color: var(--text-secondary);">ورود به درسنامه و سوالات</span>
                        </div>
                        <span class="badge">جلسه ${sess.id}</span>
                    `;
                    btn.onclick = () => openSession(sess.id);
                    grid.appendChild(btn);
                });
                containerArea.appendChild(grid);

            } else {
                subtitleEl.innerText = 'بانک سوالات ۵ بخشی و درسنامه‌های جامع';

                const notesContainer = document.createElement('div');
                notesContainer.style.marginBottom = '8px';
                notesContainer.innerHTML = `
                    <button class="btn full-width btn-accent" style="padding: 10px 14px;" onclick="openClassicNotesSessions()">
                        <div class="btn-content">
                            <span style="font-size: 0.9rem; font-weight: bold;">📖 مطالعه درسنامه‌های جامع (تفکیک‌شده)</span>
                        </div>
                        <span class="badge badge-accent">جزوه</span>
                    </button>
                `;
                containerArea.appendChild(notesContainer);

                const titleEl = document.createElement('div');
                titleEl.className = 'section-title';
                titleEl.innerText = 'بخش‌های ۵ گانه بانک سوالات';
                containerArea.appendChild(titleEl);

                const grid = document.createElement('div');
                grid.className = 'grid-menu';

                for (let i = 1; i <= 5; i++) {
                    let qRange = i === 1 ? "سوالات ۱ تا ۳۰" : i === 2 ? "سوالات ۳۱ تا ۶۰" : i === 3 ? "سوالات ۶۱ تا ۹۰" : i === 4 ? "سوالات ۹۱ تا ۱۲۰" : "سوالات ۱۲۱ تا ۱۵۳";
                    const btn = document.createElement('button');
                    btn.className = 'btn';
                    btn.style.padding = '8px 12px';
                    btn.innerHTML = `
                        <div class="btn-content">
                            <span style="font-weight: 600; font-size: 0.82rem;">بخش ${i} قارچ‌شناسی</span>
                            <span style="font-size: 0.72rem; color: var(--text-secondary);">${qRange}</span>
                        </div>
                        <span class="badge">بخش ${i}</span>
                    `;
                    btn.onclick = () => openSectionOptions(i);
                    grid.appendChild(btn);
                }
                containerArea.appendChild(grid);
            }

            updateBadges();
            updateMasteryBar();
        }

        // --- درسنامه‌های کلاسیک ---
        function openClassicNotesSessions() {
            const grid = document.getElementById('classic-notes-sessions-grid');
            grid.innerHTML = '';
            mycologyData.sessions.forEach(sess => {
                const btn = document.createElement('button');
                btn.className = 'btn';
                btn.innerHTML = `
                    <div class="btn-content">
                        <span style="font-weight: 600;">${sess.title}</span>
                        <span style="font-size: 0.8rem; color: var(--text-secondary);">مشاهده زیرمبحث‌ها و متن درسنامه</span>
                    </div>
                    <span class="badge">جزوه</span>
                `;
                btn.onclick = () => openClassicNotesSubtopics(sess.id);
                grid.appendChild(btn);
            });
            showScreen('classic-notes-sessions-screen');
        }

        function openClassicNotesSubtopics(sessId) {
            currentSession = mycologyData.sessions.find(s => s.id === sessId);
            document.getElementById('classic-sess-title').innerText = currentSession.title;
            const grid = document.getElementById('classic-notes-subtopics-grid');
            grid.innerHTML = '';

            currentSession.subtopics.forEach(sub => {
                const btn = document.createElement('button');
                btn.className = 'btn';
                btn.innerHTML = `
                    <div class="btn-content">
                        <span style="font-weight: 600;">${sub.name}</span>
                        <span style="font-size: 0.8rem; color: var(--text-secondary);">مطالعه نکات این زیرمبحث</span>
                    </div>
                    <span class="badge">مطالعه</span>
                `;
                btn.onclick = () => openClassicSummary(sub.name);
                grid.appendChild(btn);
            });
            showScreen('classic-notes-subtopics-screen');
        }

        function openClassicSummary(subName) {
            document.getElementById('summary-header-title').innerText = `درسنامه: ${subName}`;
            const sub = currentSession.subtopics.find(s => s.name === subName);
            document.getElementById('summary-content').innerHTML = sub.summary;
            showScreen('summary-screen');
        }

        function backFromSummary() {
            if (viewMode === 'modern') {
                showScreen('options-screen');
            } else {
                showScreen('classic-notes-subtopics-screen');
            }
        }

        // --- مدرن (جلسات و زیرمبحث‌ها) ---
        function openSession(sessionId) {
            currentSession = mycologyData.sessions.find(s => s.id === sessionId);
            document.getElementById('session-main-title').innerText = currentSession.title;
            
            const subGrid = document.getElementById('subtopics-grid');
            subGrid.innerHTML = '';

            currentSession.subtopics.forEach(sub => {
                const btn = document.createElement('button');
                btn.className = 'btn';
                btn.innerHTML = `
                    <div class="btn-content">
                        <span style="font-weight: 600;">${sub.name}</span>
                        <span style="font-size: 0.8rem; color: var(--text-secondary);">${sub.hasQuestions ? 'دارای درسنامه و سوال تستی' : 'فقط درسنامه آموزشی'}</span>
                    </div>
                    <span class="badge">${sub.hasQuestions ? 'درسنامه و سوال' : 'فقط درسنامه'}</span>
                `;
                btn.onclick = () => selectSubtopic(sub);
                subGrid.appendChild(btn);
            });

            showScreen('subtopics-screen');
        }

        function selectSubtopic(sub) {
            currentSubtopic = sub;
            document.getElementById('subtopic-header-title').innerText = sub.name;
            
            const qBtn = document.getElementById('btn-goto-questions');
            if (!sub.hasQuestions) {
                qBtn.style.display = 'none';
            } else {
                qBtn.style.display = 'flex';
                document.getElementById('subtopic-q-count').innerText = `${sub.qIds.length} سوال تستی`;
            }

            showScreen('options-screen');
        }

        function openSummary() {
            document.getElementById('summary-header-title').innerText = `درسنامه: ${currentSubtopic.name}`;
            document.getElementById('summary-content').innerHTML = currentSubtopic.summary;
            showScreen('summary-screen');
        }

        function openQuestionsMenu() {
            document.getElementById('qmode-header-title').innerText = `سوالات: ${currentSubtopic.name}`;
            showScreen('questions-mode-screen');
        }

        // --- حالت ۵ بخشی ---
        function openSectionOptions(sectionNum) {
            currentSectionNum = sectionNum;
            document.getElementById('section-option-title').innerText = `بخش ${sectionNum} قارچ‌شناسی`;
            showScreen('section-options-screen');
        }

        function startSectionMemorize() {
            document.getElementById('memo-header-title').innerText = `حفظ سوالات: بخش ${currentSectionNum}`;
            let startIdx = (currentSectionNum - 1) * 30;
            let endIdx = currentSectionNum === 5 ? allQuestions.length : startIdx + 30;
            let questions = allQuestions.slice(startIdx, endIdx);
            renderMemorizeCards(questions);
        }

        function startSectionQuiz() {
            userAnswers = {};
            document.getElementById('quiz-type-title').innerText = `تمرین بخش ${currentSectionNum}`;
            let startIdx = (currentSectionNum - 1) * 30;
            let endIdx = currentSectionNum === 5 ? allQuestions.length : startIdx + 30;
            let questions = allQuestions.slice(startIdx, endIdx);

            currentQuestionsList = prepareQuestions(questions);
            currentIndex = 0;
            showScreen('quiz-screen');
            renderQuestion();
        }

        function startMemorizeMode() {
            document.getElementById('memo-header-title').innerText = `حفظ سوالات: ${currentSubtopic.name}`;
            let questions = currentSubtopic.qIds.map(id => allQuestions.find(q => q.id === id)).filter(Boolean);
            renderMemorizeCards(questions);
        }

        function renderMemorizeCards(questions) {
            const container = document.getElementById('memorize-container');
            container.innerHTML = '';

            questions.forEach((qObj, idx) => {
                const card = document.createElement('div');
                card.className = 'memo-card';
                
                let optsHtml = '';
                qObj.o.forEach((optText, optIdx) => {
                    const isCorrect = (optIdx === qObj.c);
                    optsHtml += `<div class="memo-opt ${isCorrect ? 'correct-ans' : ''}">${optIdx + 1}) ${optText} ${isCorrect ? '✓ (پاسخ صحیح)' : ''}</div>`;
                });

                card.innerHTML = `<div class="memo-q">سؤال ${idx + 1}: ${qObj.q}</div><div class="memo-opts">${optsHtml}</div>`;
                container.appendChild(card);
            });

            showScreen('memorize-screen');
        }

        function startQuizMode() {
            userAnswers = {};
            document.getElementById('quiz-type-title').innerText = currentSubtopic.name;

            let questions = currentSubtopic.qIds.map(id => allQuestions.find(q => q.id === id)).filter(Boolean);
            currentQuestionsList = prepareQuestions(questions);
            currentIndex = 0;

            showScreen('quiz-screen');
            renderQuestion();
        }

        function startChallengeQuiz() {
            isChallengeMode = true;
            isBookmarkMode = false;
            userAnswers = {};
            document.getElementById('quiz-type-title').innerText = `🎯 ایستگاه چالش`;

            let filtered = allQuestions.filter(q => stats[q.id] && stats[q.id].wrongCount >= 2);
            if (filtered.length === 0) {
                CustomUI.alert('هنوز سوالی با تکرار اشتباه بالا ندارید. عالیه! 🥸');
                return;
            }

            currentQuestionsList = prepareQuestions(filtered);
            currentIndex = 0;
            showScreen('quiz-screen');
            renderQuestion();
        }

        function startBookmarkQuiz() {
            isChallengeMode = false;
            isBookmarkMode = true;
            userAnswers = {};
            document.getElementById('quiz-type-title').innerText = `⭐ سوالات نشان‌دار`;

            let filtered = allQuestions.filter(q => bookmarks[q.id]);
            if (filtered.length === 0) {
                CustomUI.alert('شما هنوز هیچ سوالی را نشان‌دار نکرده‌اید!');
                return;
            }

            currentQuestionsList = prepareQuestions(filtered);
            currentIndex = 0;
            showScreen('quiz-screen');
            renderQuestion();
        }

        function startRandomComprehensiveQuiz() {
            isChallengeMode = false;
            isBookmarkMode = false;
            userAnswers = {};
            document.getElementById('quiz-type-title').innerText = `🎲 آزمون جامع رندوم (کل سوالات)`;

            currentQuestionsList = prepareQuestions([...allQuestions]);
            currentIndex = 0;
            showScreen('quiz-screen');
            renderQuestion();
        }

        // تابع رندوم‌سازی سوالات و گزینه‌ها
        function prepareQuestions(questionsList) {
            let shuffledQuestions = shuffle(questionsList);
            return shuffledQuestions.map(item => {
                let mappedOptions = item.o.map((txt, index) => ({ text: txt, originalIndex: index }));
                return {
                    id: item.id,
                    q: item.q,
                    c: item.c,
                    shuffledOptions: shuffle(mappedOptions)
                };
            });
        }

        function renderQuestion() {
            if (currentQuestionsList.length === 0) return;

            const currentQ = currentQuestionsList[currentIndex];
            if (!stats[currentQ.id]) stats[currentQ.id] = { wrongCount: 0, consecutiveCorrect: 0 };

            document.getElementById('progress-text').innerText = `سوال ${currentIndex + 1} از ${currentQuestionsList.length}`;
            document.getElementById('question-text').innerText = currentQ.q;

            const container = document.getElementById('options-container');
            container.innerHTML = '';

            currentQ.shuffledOptions.forEach(opt => {
                const div = document.createElement('div');
                div.className = 'option-item';
                div.innerText = opt.text;
                div.setAttribute('data-original-index', opt.originalIndex);
                div.onclick = () => selectOption(div, opt.originalIndex, currentQ.c, currentQ.id);

                if (userAnswers[currentQ.id] !== undefined) {
                    div.classList.add('disabled');
                    if (opt.originalIndex === currentQ.c) div.classList.add('correct');
                    if (opt.originalIndex === userAnswers[currentQ.id] && userAnswers[currentQ.id] !== currentQ.c) div.classList.add('wrong');
                }
                container.appendChild(div);
            });

            document.getElementById('btn-prev').style.visibility = (currentIndex === 0) ? 'hidden' : 'visible';
            document.getElementById('btn-next').innerText = (currentIndex === currentQuestionsList.length - 1) ? 'پایان' : 'سوال بعدی';
            updateBookmarkBtnUI();
        }

        function selectOption(element, selectedIdx, correctIdx, qId) {
            const items = document.querySelectorAll('.option-item');
            items.forEach(item => item.classList.add('disabled'));
            userAnswers[qId] = selectedIdx;

            if (selectedIdx === correctIdx) {
                element.classList.add('correct');
                stats[qId].consecutiveCorrect++;
                if (stats[qId].consecutiveCorrect >= 3) stats[qId].wrongCount = 0;
            } else {
                element.classList.add('wrong');
                stats[qId].wrongCount++;
                stats[qId].consecutiveCorrect = 0;
                items.forEach(item => {
                    if (parseInt(item.getAttribute('data-original-index')) === correctIdx) item.classList.add('correct');
                });
            }
            saveStats();
        }

        function navigateQuestion(step) {
            currentIndex += step;
            if (currentIndex >= currentQuestionsList.length) {
                CustomUI.alert('آزمون به پایان رسید. خسته نباشید!', () => goHome());
            } else if (currentIndex < 0) {
                currentIndex = 0;
            } else {
                renderQuestion();
            }
        }

        function toggleBookmark() {
            if (currentQuestionsList.length === 0) return;
            const qId = currentQuestionsList[currentIndex].id;
            bookmarks[qId] = !bookmarks[qId];
            saveBookmarks();
            updateBookmarkBtnUI();
        }

        function updateBookmarkBtnUI() {
            if (currentQuestionsList.length === 0) return;
            const qId = currentQuestionsList[currentIndex].id;
            const btn = document.getElementById('btn-bookmark');
            if (bookmarks[qId]) {
                btn.innerText = '⭐ نشان شده';
                btn.style.background = 'rgba(234, 179, 8, 0.2)';
            } else {
                btn.innerText = '☆ نشان';
                btn.style.background = '';
            }
        }

        function saveStats() {
            localStorage.setItem('mycology_stats', JSON.stringify(stats));
            updateBadges();
            updateMasteryBar();
        }

        function saveBookmarks() {
            localStorage.setItem('mycology_bookmarks', JSON.stringify(bookmarks));
            updateBadges();
        }

        function updateBadges() {
            let chCount = 0;
            for (let qId in stats) {
                if (stats[qId].wrongCount >= 2) chCount++;
            }
            const chEl = document.getElementById('challenge-count');
            if (chEl) chEl.innerText = `${chCount} سوال`;

            let bmCount = Object.keys(bookmarks).filter(k => bookmarks[k]).length;
            const bmEl = document.getElementById('bookmark-count');
            if (bmEl) bmEl.innerText = `${bmCount} سوال`;
        }

        function updateMasteryBar() {
            const total = allQuestions.length;
            let score = 0;
            for (let qId in stats) {
                const st = stats[qId];
                if (st.consecutiveCorrect >= 3) score += 1;
                else if (st.consecutiveCorrect === 2) score += 0.6;
                else if (st.consecutiveCorrect === 1 || st.wrongCount > 0) score += 0.25;
            }
            const pct = total > 0 ? Math.round((score / total) * 100) : 0;
            document.getElementById('mastery-percentage').innerText = `${pct}%`;

            const liquid = document.getElementById('flask-liquid');
            liquid.style.height = `${pct}%`;
            liquid.className = 'liquid';

            if (pct < 30) {
                liquid.classList.add('color-low');
                document.documentElement.style.setProperty('--wave-color-1', 'rgba(190, 18, 60, 0.8)');
                document.documentElement.style.setProperty('--wave-color-2', 'rgba(225, 29, 72, 0.5)');
            } else if (pct < 60) {
                liquid.classList.add('color-mid');
                document.documentElement.style.setProperty('--wave-color-1', 'rgba(217, 119, 6, 0.8)');
                document.documentElement.style.setProperty('--wave-color-2', 'rgba(245, 158, 11, 0.5)');
            } else if (pct < 85) {
                liquid.classList.add('color-high');
                document.documentElement.style.setProperty('--wave-color-1', 'rgba(29, 78, 216, 0.8)');
                document.documentElement.style.setProperty('--wave-color-2', 'rgba(59, 130, 246, 0.5)');
            } else {
                liquid.classList.add('color-max');
                document.documentElement.style.setProperty('--wave-color-1', 'rgba(4, 120, 87, 0.8)');
                document.documentElement.style.setProperty('--wave-color-2', 'rgba(16, 185, 129, 0.5)');
            }
        }

        function showMasteryDetails() {
            const pct = parseInt(document.getElementById('mastery-percentage').innerText);
            let msg = pct < 30 ? "ابتدای راه هستید، درسنامه‌ها را دقیق‌تر مطالعه کنید!" : pct < 70 ? "پیشرفت خوبی داشتید، به تمرین ادامه دهید." : "تسلط فوق‌العاده‌ای روی مباحث قارچ‌شناسی پیدا کرده‌اید! عالیه 🌸";
            CustomUI.alert(`درصد تسلط کل شما: ${pct}%<br><br>${msg}`);
        }

        function shuffle(arr) {
            let a = [...arr];
            for (let i = a.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [a[i], a[j]] = [a[j], a[i]];
            }
            return a;
        }

        function showScreen(screenId) {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.getElementById(screenId).classList.add('active');
        }

        function goHome() {
            showScreen('dashboard-screen');
            renderDashboard();
        }

        function backToSubtopics() {
            showScreen('subtopics-screen');
        }

        function backToOptions() {
            showScreen('options-screen');
        }

        function backToPreviousFromMemorize() {
            if (viewMode === 'modern') {
                showScreen('questions-mode-screen');
            } else {
                showScreen('section-options-screen');
            }
        }

        // تم لایت/دارک
        const themeToggleBtn = document.getElementById('theme-toggle');
        if (localStorage.getItem('mycology_theme') === 'light') {
            document.body.classList.add('light-mode');
            themeToggleBtn.innerText = '🌙';
        }

        themeToggleBtn.addEventListener('click', () => {
            document.body.classList.toggle('light-mode');
            if (document.body.classList.contains('light-mode')) {
                localStorage.setItem('mycology_theme', 'light');
                themeToggleBtn.innerText = '🌙';
            } else {
                localStorage.setItem('mycology_theme', 'dark');
                themeToggleBtn.innerText = '☀️';
            }
        });

        window.onload = () => {
            checkUser();
        };
    </script>
</body>
</html>
