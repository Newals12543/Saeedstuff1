            { id: 15, q: "کدام مورد از شرایط لازم جهت ابتلا به تینه آ ورسیکالر است؟", o: ["سن در دوره دبستان", "مسری است", "ابتلا به ایدز", "چرب بودن پوست"], c: 3 },
            { id: 16, q: "کدام نمونه بعد دو ساعت ارزش آزمایش قارچی ندارد؟", o: ["خلط", "ناخن", "موی سر", "چسب اسکاچ"], c: 0 },
            { id: 17, q: "اکتینومایسس اسرائیلی ........ است.", o: ["قارچی دوشکلی", "مخمر", "عامل فک ناهنجار است", "هیفومیست"], c: 2 },
            { id: 18, q: "درمان کچلی ریش است.", o: ["گریزئوفولوین", "پنی سیلین", "پیماریسین", "فلوسیتوزین"], c: 0 },
