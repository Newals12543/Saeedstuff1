            { id: 2, q: "ویژگی قارچ ها نیست ؟", o: ["Mould و mushroom بودن", "مخمری و رشته ای بودن", "حرکت آمیبی", "رشته های فاقد تیغه میانی"], c: 2 },
            { id: 3, q: "کدامیک از عبارات زیر صحیح است؟", o: ["قارچ های ناقص دارای تولید مثل جنسی هستند", "قارچ ها موجوداتی دیپلوئید هستند", "جمعیت قارچ ها کمتر از ۵۰۰۰۰ است", "آسکومایکوتا عضو شاخه دیکاریومایکوتا هستند"], c: 3 },
            { id: 4, q: "دمای مناسب رشد قارچ ها است.", o: ["16", "26", "36", "37"], c: 1 },
            { id: 5, q: "از ویژگی قارچها نیست:", o: ["واجد ساختمان مخمری هستند", "فتوسنتز کننده هستند", "غشای سیتوپلاسم واجد ارگوسترول است", "رشد در دمای ۲۵ درجه سانتی گراد"], c: 1 },
            { id: 6, q: "این سم قارچی بسیار مرگبار است:", o: ["Amanitin", "L.S.D", "Aflatoxin", "هیچکدام"], c: 0 },
            { id: 7, q: "این سم قارچی از کشندگی بسیار بالاتری برخوردار است؟", o: ["L.S.D", "PSILOCYBE", "AMANITIN", "AFLATOXIN"], c: 2 },
            { id: 8, q: "کدامیک از مایکوتوکسین های زیر به شدت مرگبار است؟", o: ["AFLATOXIN", "L.S.D", "AMANITIN", "PSILOCYBE"], c: 2 },
            { id: 9, q: "شفاف کننده مناسب مو در تشخیص قارچ است.", o: ["کاتن بلو", "KOH", "لاکتوفنل", "BHI"], c: 2 },
            { id: 10, q: "کدام نمونه پس از ۲ ساعت ارزش آزمایش قارچ شناسی ندارد ؟", o: ["نمونه خلط", "چسب اسکاج", "نمونه موی سر", "نمونه ناخن"], c: 0 },
            { id: 11, q: "زمینه مساعد جهت ابتلا به بیماری پیتریازیس ورسیکالر است؟", o: ["ابتلا به سل", "تعریق", "تماس با حیوانات", "مصرف بی رویه آنتی بیوتیک ها"], c: 1 },
            { id: 12, q: "مالاسزیا فورفور .......", o: ["در ایران وجود ندارد", "دیمورفیک است", "عامل لکه صورت است", "هیچکدام"], c: 2 },
            { id: 13, q: "مناسب ترین روش تشخیص آزمایشگاهی بیماری تینه آ ورسیکالر است:", o: ["سرولوژی", "تلقیح به حیوان آزمایشگاهی", "تست جلدی", "دید مستقیم میکروسکوپی"], c: 3 },
