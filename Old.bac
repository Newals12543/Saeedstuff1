            { id: 140, q: "کتوکونازول در درمان ......... کارایی دارد ؟", o: ["کوکسید یوئید و مایوکوزیس", "آسپرژیلوزیس", "اسپوروتریکوزیس جلدی لنفاوی", "تینه آورسیکالر"], c: 3 },
