            { id: 20, q: "شایع ترین عامل کچلی فاووس کدام است؟", o: ["Trichophyton schoenleinii", "Trichophyton rubrum", "Trichophyton tonsurans", "Epidermophyton floccosum"], c: 0 },
            { id: 21, q: "نام این بیماری قارچ چیست؟ (اسپاگتی و کوفته قلقلی)", o: ["Pityriasis versicolor", "Ectothrix", "Endothrix", "Favus"], c: 0 },
            { id: 22, q: "تولید گره نرم و روشن در ساقه مو میکند:", o: ["فاووس", "کچلی اندو تریکس", "پیتریازیس ورسیکالر", "پیدرای سفید"], c: 3 },
            { id: 23, q: "مزمن ترین فرم کچلی کدام است؟", o: ["کچلی بدن", "کچلی ناخن", "اکتوتریکس", "کچلی دست"], c: 1 },
            { id: 24, q: "درمان اختصاصی کچلی ناخن است:", o: ["Penicillin", "Erythromycin", "Amphotericin-B", "Terbinafine"], c: 3 },
            { id: 25, q: "این درماتوفیت شایع ترین عامل کچلی ناخن است:", o: ["T. verrucosum", "T. rubrum", "M. canis", "T. tonsurans"], c: 1 },
            { id: 26, q: "این درماتوفیت عامل بیماری کچلی مزمن در انسان است:", o: ["Microsporum audouinii", "Trichophyton verrucosum", "Epidermophyton floccosum", "Trichophyton rubrum"], c: 3 },
            { id: 27, q: "پوست چرب زمینه ابتلا به کدام بیماری است؟", o: ["Tinea capitis", "Tinea versicolor", "Tinea nigra", "Dermatophytosis"], c: 1 },
            { id: 28, q: "لکه های قهوه ای روی شانه یک بیمار نشانه کدام بیماری است؟", o: ["کچلی بدن", "فاووس", "تینه آ ورسیکالر", "پیدرا"], c: 2 },
            { id: 29, q: "این درماتوفیت حیوان دوست و عامل کچلی اکتوتریکس است؟", o: ["T. rubrum", "M. canis", "E. floccosum", "M. gypseum"], c: 1 },
            { id: 30, q: "کدامیک از عبارات زیر در مورد کچلی ها غلط است؟", o: ["نمونه مو را در محیط SCC کشت میدهند", "ترایکوفایتون روبروم عامل کچلی پا است", "در کچلی بدن نمونه از مرکز ضایعه گرفته میشود", "درمان در کچلی ناخن طولانی است"], c: 2 },
            { id: 31, q: "میکروسپوروم کانیس...", o: ["حیوان دوست و عامل اندوتریکس", "انسان دوست اندوتریکس", "حیوان دوست عامل اکتوتریکس", "انسان دوست اکتوتریکس"], c: 2 },
            { id: 32, q: "شایعترین عامل فاووس است.", o: ["ترایکوفایتون روبروم", "ترایکوفایتون ویولاسئوم", "ترایکوفایتون تونسورانس", "هیچ کدام"], c: 3 },
