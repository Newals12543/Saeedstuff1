            { id: 41, q: "این درماتوفیت عامل کچلی مزمن کف پا است:", o: ["میکروسپوروم جیپسئوم", "ترایکوفایتون روبروم", "ترایکوفایتون وروکوزوم", "میکروسپوروم کانیس"], c: 1 },
            { id: 42, q: "تحت اشعه وود لامپ فلورسانس زرد طلایی در بیماری:", o: ["پتریازیس ورسیکالر", "اریتراسما", "فاووس", "اکتوتریکس"], c: 0 },
