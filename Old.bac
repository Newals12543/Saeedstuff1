            { id: 49, q: "شایعترین عامل کچلی کشاله ران است ؟", o: ["ترایکوفایتون شوئن لاینی", "میکروسپوروم چیپسئوم", "میکروسپوروم کنیس", "اپیدرموفایتون فلوکوزوم"], c: 3 },
            { id: 50, q: "نام این قارچ چیست؟ (ماکروکونیدی دوکی‌شکل خاردار)", o: ["Trichophyton mentagrophytes", "Trichophyton verrucosum", "Trichophyton rubrum", "Microsporum canis"], c: 3 },
            { id: 51, q: "کدام یک از درماتوفیتهای زیر حیوان دوست است؟", o: ["E. floccosum", "T. schoenleinii", "T. verrucosum", "T. rubrum"], c: 2 },
            { id: 52, q: "عامل سفیدک سطحی است.", o: ["ترایکوفیتون تونسورانس", "ترایکوفایتون منتاگروفایتس", "ترایکوفایتون روبروم", "ترایکوفایتون وروکوزوم"], c: 1 },
            { id: 53, q: "نام این قارچ چیست ؟ (ماکروکونیدی‌های دوکی‌شکل با دیواره ضخیم و خاردار)", o: ["ترایکوفایتون وروکوزوم", "میکروسپوروم کنیس", "اپیدرموفایتون فلوکوزوم", "ترایکوفایتون روبروم"], c: 1 },
            { id: 54, q: "شایعترین عامل سفیدک سطحی قارچی ناخن کدام است؟", o: ["میکروسپوروم کنیس", "ترایکوفایتون منتاگروفایتس", "ترایکوفایتون ویولا سئوم", "ترایکوفایتون وروکوزوم"], c: 1 },
            { id: 55, q: "مخزن آن گربه است ؟", o: ["E.flocosum", "M.canis", "T.tonsurans", "T.violaceum"], c: 1 },
            { id: 56, q: "این بیماری با چسب اسکاچ تشخیص داده می شود.", o: ["کچلی ریش", "تینه آ ورسیکالر", "اسپورتریکوزیس", "رینواسپوریدیوزیس"], c: 1 },
            { id: 57, q: "این قارچ دوشکلی است.", o: ["هیستوپلاسما کپسولاتوم", "پاراکوکسیدیویدس برازیلینسیس", "اسپوروتریکس شنکئی", "همه موارد فوق"], c: 3 },
            { id: 58, q: "کدام عبارت در مورد اسپورتریکس شنکئی درست است؟", o: ["قارچی است مخمری", "قارچی دوشکلی است", "فقط در پوست ایجاد بیماری میکند", "قارچ تیره است"], c: 1 },
            { id: 59, q: "توده زیر جلدی در پای یک بیمار با سابقه دو سال ممکن است ......... باشد:", o: ["Tinea nigra", "Sporotrichosis", "Rhinosporidiosis", "Mycetoma"], c: 3 },
            { id: 60, q: "این بیماری ایجاد گرانول میکند:", o: ["کچلی سر", "پارونیشیا", "کچلی بدن", "مایستوما"], c: 3 },
            { id: 61, q: "این بیماری فقط با دید مستقیم میکروسکوپ قابلیت شناسایی دارد:", o: ["Rhinosporidiosis", "Sporotrichosis", "Chromoblastomycosis", "Mycetoma"], c: 0 },
            { id: 62, q: "زنجیره ای از ضایعات جلدی لنفاوی نشانه ی کدام بیماری زیر جلدی است:", o: ["Sporotrichosis", "Mycetoma", "Dermatophytosis", "Rhinosporidiosis"], c: 0 },
            { id: 63, q: "عامل مایستومای قارچی کدام است:", o: ["M. furfur", "T. verrucosum", "M. canis", "Pseudallescheria boydii"], c: 3 },
            { id: 64, q: "در خصوص اسپوروتریکس شنکئی کدام گزینه غلط است؟", o: ["قارچی دوشکلی است", "در دمای ۲۵ درجه به شکل رشته ای گل مینائی دیده می شود.", "فرم ریوی شبیه سل ریوی است", "در بافت بدن تولید اسفرول می نماید"], c: 3 },
            { id: 65, q: "توده زیر جلدی که اغلب پاها را مبتلا میکند و باعث تغییر شکل عضو می شود را .............. می گویند", o: ["کچلی بدن", "مای ستوما", "کچلی پا", "پیتریازیس ورسیکالر"], c: 1 },
            { id: 66, q: "یکی از عوامل مایستوما قارچی کدام است؟", o: ["پنیسلیوم", "کلاسد و پوریوم", "الشریا بوئیدی", "آلترنتریا"], c: 2 },
            { id: 67, q: "کدامیک از عبارات زیر غلط است ؟", o: ["ارگوسترول ترکیب غشا سیتوپلاسمی قارچها را تشکیل میدهد.", "مورکومایکوزیس رینو سربال روندی حاد دارد.", "فرم جلدی لنفاوی شایعترین فرم اسپورتریکوزیس است.", "آمفوتریسین ب ، درمان انتخابی پیتریازیس ورسیکالر است."], c: 3 },
            { id: 68, q: "میزبان هیستوپلاسما کپسولاتوم ......... است:", o: ["کبوتر", "گاو", "گوسفند", "خفاش"], c: 3 },
            { id: 69, q: "کدامیک از جملات زیر غلط است؟", o: ["ترایکوفایتون منتاگروفایتس عامل کچلی ریش است.", "فرم غالب کچلی بدن حلقه های قرمز است.", "میکروسپوروم کانیس ایجاد کچلی سر در انسان می نماید.", "هیستوپلاسموزیس عفونت ریوی است که از ایران گزارش شده است."], c: 3 },
            { id: 70, q: "این بیماری در مبتلایان به دیابت شایع است.", o: ["Mycetoma", "Mucormycosis", "Piedra", "Dermatophytosis"], c: 1 },
            { id: 71, q: "قارچی دوشکلی است؟", o: ["هیستوپلاسما", "موکور", "ترایکوفایتون", "هیچکدام"], c: 0 },
            { id: 72, q: "مرگبارترین فرم موکور مایکوزیس است:", o: ["ریوی", "گوارشی", "رینو سربرال", "جلدی"], c: 2 },
            { id: 73, q: "در بیمار مبتلا به موکور مایکوزیس کدام روش تشخیصی آزمایشگاهی و کدام دارو را جهت درمان توصیه می کنید؟", o: ["تست گالاکتومانان، درمان آمفوتریسین ب", "تراشه داخل بینی به شکل پتاس، درمان آمفوتریسین - ب", "رنگ آمیزی تولوئیدن بلو خلط، درمان کوتریموکسازول", "هیچکدام"], c: 1 },
            { id: 74, q: "کدامیک از عبارات زیر در مورد موکورمایکوزیس غلط است؟", o: ["لوسمی یکی از زمینه های مهم ابتلاء است", "موکورمیکوزیس جلدی غالبا متعاقب سوختگی ها ایجاد میشود", "موکورمایکوزیس پوستی را شانکر اسپوروتریکوم می گویند", "رایزوپوس از مهمترین عوامل بیماری است"], c: 2 },
            { id: 75, q: "کدام در مورد موکور مایکوزیس رینو سربرال غلط است؟", o: ["دیابت زمینه ابتلاست", "دید مستقیم میکروسکوپی از نمونه داخل بینی تهیه میشود.", "بیماری سیر بسیار کند و مزمنی دارد.", "رایزوپوس شایع ترین عامل بیماری است."], c: 2 },
            { id: 76, q: "کدام غلط است؟", o: ["فرم جلدی لنفاوی شایع ترین فرم اسپورتریکوزیس است.", "موکورمایکوزیس رینو سبرال روندی حاد دارد.", "آمفوتریسین درمان انتخابی اریتراسما است.", "ارگسترول ترکیب غشا سیتوپلاسمی قارچ ها را تشکیل میدهد."], c: 2 },
            { id: 77, q: "کدام یک از عبارات زیر در مورد موکور مایکوزیس رینو سربرال غلط است ؟", o: ["با تریبینافین درمان میشود بیماری سیر کند و مزمنی دارد.", "دید مستقیم میکروسکوپی را میتوان از داخل تراشه بینی تهیه نمود.", "دید مستقیم میکروسکوپی و کشت تنها راه تشخیص بیماری است.", "رایزوپوس شایع ترین عامل بیماری است."], c: 0 },
            { id: 78, q: "In microscopic study, how does Mucor appear in the patient's tissue?", o: ["none of them", "Favus", "Septate hanched (dichotomous) hyphae", "aseptate hyphae"], c: 3 },
            { id: 79, q: "این بیماری مسری و مشترک بین انسان و حیوان است.", o: ["کچلی ریش", "برفک", "رینوسپوریدیوزیس", "هیستوپلاسموزیس"], c: 0 },
