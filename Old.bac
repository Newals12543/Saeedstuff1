            { id: 110, q: "شکل مقابل قارچ ... است. (ساختار قلم‌مویی شکل)", o: ["Alternaria", "Aspergillus", "Penicillium", "Candida"], c: 2 },
            { id: 111, q: "نام این قارچ (هایف فنری) چیست؟", o: ["Trichophyton rubrum", "Aspergillus", "Penicillium", "Trichophyton mentagrophytes"], c: 3 },
            { id: 112, q: "یدید پتاسیم برای درمان این بیماری است:", o: ["Aspergillosis", "Mucormycosis", "Sporotrichosis", "Pneumocystosis"], c: 2 },
            { id: 113, q: "این بیماری باعث کاهش اکسیژن خون محیطی بیمار میشود:", o: ["Mucormycosis", "Histoplasmosis", "Aspergillosis", "Pneumocystosis"], c: 3 },
            { id: 114, q: "مخزن این قارچ کبوتر است؟", o: ["Aspergillus fumigatus", "Sporothrix schenckii", "Mucor spp", "Cryptococcus neoformans"], c: 3 },
