            { id: 44, q: "کدام درماتوفیت بیشتر مسبب کچلی کشاله ران است؟", o: ["M. canis", "E. floccosum", "T. tonsurans", "T. violaceum"], c: 1 },
            { id: 45, q: "خالهای سیاه یا نقاط سیاه روی پوست سر (black dots) در .... دیده میشود.", o: ["ترایکومایکوزیس", "اندوتریکس", "اگزوتریکس", "فاووس"], c: 1 },
            { id: 46, q: "نام این بیماری قارچی (هایف و اسپور درون مو) چیست ؟", o: ["اکتوتریکس", "فاووس", "تینه آورسیکالر", "اندوتریکس"], c: 3 },
