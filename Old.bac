            { id: 34, q: "کدامیک از عبارات زیر در مورد قارچ ها غلط است؟", o: ["در clamp connection زیگومایکوتا دیده می شود", "ترایکوفایتون منتاگروفایتس عامل کچلی پا است", "در کچلی ناخن نمونه از بستر ناخن گرفته میشود", "ترایکوفایتون ها به پوست مو و ناخن حمله میکنند"], c: 0 },
            { id: 35, q: "عامل کچلی اندوتریکس است.", o: ["اپیدرموفایتون فلوکوزوم", "ترایکوفایتون وروکوزوم", "ترایکوفایتون تونسورانس", "هیچکدام"], c: 2 },
